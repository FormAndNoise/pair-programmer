# Model Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default Pair Selection
MODEL_A=anthropic/claude-3-5-sonnet-20241022
MODEL_B=gemini/gemini-2.5-flash

# Execution Sandbox Configuration
SANDBOX_MODE=local_process   # Options: local_process | docker
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_OUTPUT_CHARS=10000

# Automated Version Control (Phase 4 GitManager)
GIT_AUTOMATION=0             # Options: 0 | 1 (or use --git CLI flag)
GIT_BASE_BRANCH=main
